        "id",
        "ownerUid",
        "ownerName",
        "sourceStoryId",
        "title",
        "universe",
        "setting",
        "tone",
        "premise",
        "protagonistId",
        "turns",
        "characters",
        "crossIndex",
        "chapters",
        "savePoints",
        "lastEditedByUid",
        "lastEditedByName",
        "clientUpdatedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "CollaborationMember": {

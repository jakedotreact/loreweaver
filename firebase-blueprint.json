{
  "entities": {
    "UserSettings": {
      "title": "UserSettings",
      "description": "Private user account profile, persistent studio preferences, and per-user model associations.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name from OAuth profile.",
          "maxLength": 120
        },
        "username": {
          "type": "string",
          "description": "Custom freely chooseable public author/reader handle.",
          "minLength": 1,
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address from OAuth profile.",
          "maxLength": 254
        },
        "photoURL": {
          "type": "string",
          "description": "Optional avatar URL from OAuth profile.",
          "maxLength": 500
        },
        "preferredModel": {
          "type": "string",
          "description": "User's default Gemini narrative model ID.",
          "minLength": 1,
          "maxLength": 100
        },
        "thinkingLevel": {
          "type": "string",
          "description": "User's default reasoning depth.",
          "enum": ["MINIMAL", "LOW", "MEDIUM", "HIGH", "XHIGH"]
        },
        "preferredVoice": {
          "type": "string",
          "description": "User's default Text-to-Speech narrator voice.",
          "enum": ["Kore", "Charon", "Fenrir", "Puck", "Zephyr"]
        },
        "autoPlayNarration": {
          "type": "boolean",
          "description": "Whether pre-computed narration automatically starts playback on success."
        },
        "allowedModels": {
          "type": "array",
          "description": "Bounded list of Gemini model IDs associated with this user account (empty means all non-paid models)."
        },
        "activeStoryId": {
          "type": "string",
          "description": "ID of the user's most recently active story.",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when settings document was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when settings document was last updated."
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "preferredModel",
        "thinkingLevel",
        "preferredVoice",
        "allowedModels",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserStory": {
      "title": "UserStory",
      "description": "Persistent interactive story project belonging to a specific authenticated user (excludes binary image payloads).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique story identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the story owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Story title.",
          "minLength": 1,
          "maxLength": 200
        },
        "universe": {
          "type": "string",
          "description": "Fictional universe or canon.",
          "maxLength": 200
        },
        "setting": {
          "type": "string",
          "description": "Setting and era.",
          "maxLength": 400
        },
        "tone": {
          "type": "string",
          "description": "Narrative tone and genre.",
          "maxLength": 200
        },
        "premise": {
          "type": "string",
          "description": "Opening premise prompt.",
          "maxLength": 4000
        },
        "prefixNote": {
          "type": "string",
          "description": "Optional beginning author note displayed before the story.",
          "maxLength": 4000
        },
        "suffixNote": {
          "type": "string",
          "description": "Optional ending author note displayed after the story.",
          "maxLength": 4000
        },
        "protagonistId": {
          "type": "string",
          "description": "Character ID of the protagonist.",
          "maxLength": 128
        },
        "turns": {
          "type": "array",
          "description": "Chronological narrative turns."
        },
        "characters": {
          "type": "array",
          "description": "Cast profiles."
        },
        "crossIndex": {
          "type": "array",
          "description": "Cross-Index continuity ledger."
        },
        "chapters": {
          "type": "array",
          "description": "Merged chapter groupings."
        },
        "savePoints": {
          "type": "array",
          "description": "Manual or automatic checkpoints."
        },
        "shareId": {
          "type": "string",
          "description": "Optional active public read-only share ID for the full story.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "collabId": {
          "type": "string",
          "description": "Optional active live collaboration room ID for the story.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "publicStoryId": {
          "type": "string",
          "description": "Deterministic or assigned public Story Index identifier.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isPrivate": {
          "type": "boolean",
          "description": "When true, strictly excludes this story from the public Landing Page Story Index."
        },
        "tags": {
          "type": "object",
          "description": "AO3-style structured story taxonomy (rating, warnings, categories, fandoms, relationships, characters, freeforms)."
        },
        "clientUpdatedAt": {
          "type": "number",
          "description": "Client millisecond timestamp for merge ordering."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when story was first synced."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when story was last synced."
        }
      },
      "required": [
        "id",
        "ownerUid",
        "title",
        "universe",
        "setting",
        "tone",
        "premise",
        "protagonistId",
        "turns",
        "characters",
        "crossIndex",
        "chapters",
        "savePoints",
        "clientUpdatedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "SharedWork": {
      "title": "SharedWork",
      "description": "Link-shareable snapshot of a full story, organized chapter, or individual scene without private user PII.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unguessable share identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the publishing author.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "description": "Public display or pen name of the author (non-PII).",
          "minLength": 1,
          "maxLength": 120
        },
        "scope": {
          "type": "string",
          "description": "Granularity of the shared snapshot.",
          "enum": ["story", "chapter", "scene"]
        },
        "sourceStoryId": {
          "type": "string",
          "description": "ID of the source story.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetId": {
          "type": "string",
          "description": "Target chapter or turn ID when scope is chapter or scene.",
          "maxLength": 128
        },
        "storyTitle": {
          "type": "string",
          "description": "Parent story title.",
          "minLength": 1,
          "maxLength": 200
        },
        "workTitle": {
          "type": "string",
          "description": "Display title of the shared story, chapter, or scene.",
          "minLength": 1,
          "maxLength": 200
        },
        "universe": {
          "type": "string",
          "description": "Fictional universe or canon.",
          "maxLength": 200
        },
        "setting": {
          "type": "string",
          "description": "Setting and era.",
          "maxLength": 400
        },
        "tone": {
          "type": "string",
          "description": "Narrative tone.",
          "maxLength": 200
        },
        "premise": {
          "type": "string",
          "description": "Story opening premise.",
          "maxLength": 4000
        },
        "summary": {
          "type": "string",
          "description": "Optional chapter summary or note.",
          "maxLength": 1000
        },
        "prefixNote": {
          "type": "string",
          "description": "Optional beginning author note displayed before the shared work.",
          "maxLength": 4000
        },
        "suffixNote": {
          "type": "string",
          "description": "Optional ending author note displayed after the shared work.",
          "maxLength": 4000
        },
        "turns": {
          "type": "array",
          "description": "Ordered turns included in the shared snapshot."
        },
        "chapters": {
          "type": "array",
          "description": "Chapter groupings included when sharing a story or chapter."
        },
        "characters": {
          "type": "array",
          "description": "Fictional cast profiles relevant to the shared work."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the share link was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the share snapshot was last updated."
        }
      },
      "required": [
        "id",
        "ownerUid",
        "authorName",
        "scope",
        "sourceStoryId",
        "targetId",
        "storyTitle",
        "workTitle",
        "universe",
        "setting",
        "tone",
        "premise",
        "summary",
        "turns",
        "chapters",
        "characters",
        "createdAt",
        "updatedAt"
      ]
    },
    "StoryCollaboration": {

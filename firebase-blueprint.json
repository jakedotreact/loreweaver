        },
        "title": {
          "type": "string",
          "description": "Collaborative story title.",
          "minLength": 1,
          "maxLength": 200
        },
        "universe": {
          "type": "string",
          "description": "Fictional universe or canon.",
          "maxLength": 200
        },
        "setting": {
          "type": "string",
          "description": "Setting and era.",
          "maxLength": 400
        },
        "tone": {
          "type": "string",
          "description": "Narrative tone.",
          "maxLength": 200
        },
        "premise": {
          "type": "string",
          "description": "Opening premise.",
          "maxLength": 4000
        },
        "prefixNote": {
          "type": "string",
          "description": "Optional beginning author note displayed before the story.",
          "maxLength": 4000
        },
        "suffixNote": {
          "type": "string",
          "description": "Optional ending author note displayed after the story.",
          "maxLength": 4000
        },
        "protagonistId": {
          "type": "string",

  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserSettings"
      },
      "description": "Per-user private OAuth profile, persistent studio preferences, and model associations."
    },
    "/users/{userId}/stories/{storyId}": {
      "schema": {
        "$ref": "#/entities/UserStory"
      },
      "description": "User-owned interactive story manuscripts synced across devices without oversized binary image payloads."
    },
    "/users/{userId}/collections/{collectionId}": {
      "schema": {
        "$ref": "#/entities/UserCollection"
      },
      "description": "Per-user curated collections referencing story IDs."
    },
    "/users/{userId}/subscriptions/{storyId}": {
      "schema": {
        "$ref": "#/entities/StorySubscription"
      },
      "description": "Per-user story subscriptions tracking read/seen story progress."
    },
    "/sharedWorks/{shareId}": {
      "schema": {
        "$ref": "#/entities/SharedWork"
      },
      "description": "Publicly readable by exact shareId snapshot documents for shared full stories, chapters, or scenes."
    },
    "/collaborations/{collabId}": {
      "schema": {
        "$ref": "#/entities/StoryCollaboration"
      },
      "description": "Live multi-user co-authoring manuscripts keyed by unguessable collabId."
    },
    "/collaborations/{collabId}/members/{memberUid}": {
      "schema": {
        "$ref": "#/entities/CollaborationMember"
      },
      "description": "Authorized collaborator membership subcollection enforcing synchronous access control and revocation."
    },
    "/publicStories/{publicId}": {
      "schema": {
        "$ref": "#/entities/PublicStory"
      },
      "description": "Publicly indexed works surfaced on the Landing Page Story Index (where isPrivate == false) with AO3 taxonomy and atomic kudos/comment counters."
    },
    "/publicStories/{publicId}/kudos/{kudoId}": {
      "schema": {
        "$ref": "#/entities/StoryKudo"
      },

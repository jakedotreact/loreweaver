rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny unless explicitly permitted below.
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserSettings(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'preferredModel',
          'thinkingLevel',
          'preferredVoice',
          'allowedModels',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'preferredModel',
          'thinkingLevel',
          'preferredVoice',
          'allowedModels',
          'activeStoryId',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() <= 254
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.preferredModel is string
        && data.preferredModel.size() >= 1
        && data.preferredModel.size() <= 100
        && data.thinkingLevel in ['MINIMAL', 'LOW', 'MEDIUM', 'HIGH', 'XHIGH']
        && data.preferredVoice in ['Kore', 'Charon', 'Fenrir', 'Puck', 'Zephyr']
        && data.allowedModels is list
        && data.allowedModels.size() <= 20
        && (data.allowedModels.size() == 0 || data.allowedModels[0] is string)
        && (!('activeStoryId' in data) || (data.activeStoryId is string && data.activeStoryId.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserStory(data, userId, storyId) {
      return data.keys().hasAll([
          'id',
          'ownerUid',
          'title',
          'universe',
          'setting',
          'tone',
          'premise',
          'protagonistId',
          'turns',
          'characters',
          'crossIndex',
          'chapters',
          'savePoints',
          'clientUpdatedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerUid',
          'title',
          'universe',
          'setting',
          'tone',
          'premise',
          'protagonistId',
          'turns',
          'characters',
          'crossIndex',
          'chapters',
          'savePoints',
          'clientUpdatedAt',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == storyId
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && data.ownerUid == userId
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.universe is string
        && data.universe.size() <= 200
        && data.setting is string
        && data.setting.size() <= 400
        && data.tone is string
        && data.tone.size() <= 200
        && data.premise is string
        && data.premise.size() <= 4000
        && data.protagonistId is string
        && data.protagonistId.size() <= 128
        && data.turns is list
        && data.turns.size() <= 200
        && (data.turns.size() == 0 || data.turns[0] is map)
        && data.characters is list
        && data.characters.size() <= 100
        && (data.characters.size() == 0 || data.characters[0] is map)
        && data.crossIndex is list
        && data.crossIndex.size() <= 300
        && (data.crossIndex.size() == 0 || data.crossIndex[0] is map)
        && data.chapters is list
        && data.chapters.size() <= 100
        && (data.chapters.size() == 0 || data.chapters[0] is map)
        && data.savePoints is list
        && data.savePoints.size() <= 50
        && (data.savePoints.size() == 0 || data.savePoints[0] is map)
        && data.clientUpdatedAt is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserSettings(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserSettings(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'photoURL',
          'preferredModel',
          'thinkingLevel',
          'preferredVoice',
          'allowedModels',
          'activeStoryId',
          'updatedAt'
        ]);
      allow delete: if false;

      match /stories/{storyId} {
        allow get: if isValidId(userId)
          && isValidId(storyId)
          && isOwner(userId)
          && existing().ownerUid == request.auth.uid;
        allow list: if isOwner(userId)
          && existing().ownerUid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(storyId)
          && isOwner(userId)
          && isValidUserStory(incoming(), userId, storyId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidId(storyId)
          && isOwner(userId)
          && isValidUserStory(incoming(), userId, storyId)
          && incoming().id == existing().id
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'universe',
            'setting',
            'tone',
            'premise',
            'protagonistId',
            'turns',
            'characters',
            'crossIndex',
            'chapters',
            'savePoints',
            'clientUpdatedAt',
            'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId)
          && isValidId(storyId)
          && isOwner(userId)
          && existing().ownerUid == request.auth.uid;
      }
    }
  }
}

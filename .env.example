# GEMINI_API_KEY: Required for server-side Gemini AI API calls (never expose in client code).
# Users configure this via the Secrets panel in the AI Studio UI or in local .env / .env.local.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Web Client Configuration (store rotated values in gitignored .env.local):
# In Google Cloud Console -> APIs & Services -> Credentials:
# 1. Restrict the browser key by HTTP Referrer to your app origins + http://localhost:3000/*
# 2. Restrict API targets strictly to Identity Toolkit API, Cloud Firestore API, and Token Service API
#    (NEVER allow Generative Language API on a client-side Firebase key).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0202913361.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0202913361"
VITE_FIREBASE_APP_ID="1:993079182477:web:d5aed1f652d5e968170ec4"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-loreweaver-dbc8c0e2-66d7-4036-9e54-134fc0d4b6e5"
